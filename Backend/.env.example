# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:  cp .env.example .env
# .env ตัวจริงถูก gitignore ไว้ (ไม่ถูก commit)

# ---- Logging ----
# ระดับ log: debug | info | warn | error
LOG_LEVEL=info

# ---- Database: PostgreSQL ----
DB_HOST=localhost          # local run = localhost / ใน docker = ชื่อ service (เช่น postgres)
DB_PORT=5432
DB_USER=ecommerce
DB_PASSWORD=change-me
DB_NAME=ecommerce
DB_SSLMODE=disable         # dev = disable / prod = require

# ---- Auth / JWT (ใช้ตอน Phase 4) ----
JWT_SECRET=change-this-secret-in-production

# หมายเหตุ: PORT ของแต่ละ service ไม่ต้องใส่ (มี default ในโค้ด + compose set ให้)
